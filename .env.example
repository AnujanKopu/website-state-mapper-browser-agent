# Copy to .env and adjust as needed. All variables are optional and have sane defaults.

# Database. SQLite by default; swap to Postgres with no code changes, e.g.:
#   FLOWSTATE_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/flowstate
FLOWSTATE_DATABASE_URL=sqlite+aiosqlite:///data/flowstate.db

# Root directory for run artifacts (screenshots, DOM snapshots).
FLOWSTATE_DATA_DIR=data

# Path to the run configuration YAML.
FLOWSTATE_RUN_CONFIG_PATH=config/default_run.yaml

# Hosted mode delegates every crawl to the private one-run supervisor.
# FLOWSTATE_HOSTED_MODE=true
# FLOWSTATE_SUPERVISOR_URL=http://127.0.0.1:8091
# FLOWSTATE_SUPERVISOR_TOKEN=replace-with-a-long-random-secret
# FLOWSTATE_WORKER_JOB_ROOT=/var/lib/flowstate/jobs

# LLM provider keys (used from milestone M2 onward, via config/models.yaml).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
