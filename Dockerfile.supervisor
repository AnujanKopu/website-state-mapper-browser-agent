FROM docker:27-cli

RUN apk add --no-cache python3 py3-pip \
    && python3 -m venv /opt/supervisor \
    && /opt/supervisor/bin/pip install --no-cache-dir fastapi uvicorn

ENV PATH=/opt/supervisor/bin:$PATH \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY supervisor ./supervisor

ENTRYPOINT ["uvicorn", "supervisor.main:app", "--host", "0.0.0.0", "--port", "8091"]
